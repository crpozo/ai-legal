# Proveedor del modelo: "anthropic" (por defecto) o "bedrock".
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Con bedrock se usan las credenciales AWS del entorno (AWS_PROFILE, AWS_REGION).
# AWS_PROFILE=mindfultech
# AWS_REGION=us-east-1

# Modelos. Extracción = muchas llamadas pequeñas; reporte = pocas llamadas de síntesis.
# MODEL_EXTRACCION=claude-haiku-5-5
# MODEL_REPORTE=claude-opus-5-5
# En Bedrock los IDs llevan prefijo de perfil de inferencia, por ejemplo:
# MODEL_EXTRACCION=us.anthropic.claude-haiku-5-5
